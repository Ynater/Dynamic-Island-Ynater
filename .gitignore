@'
node_modules/
dist/
electron-data/
*.log
.DS_Store
'@ | Out-File -FilePath .gitignore -Encoding UTF8

# Инициализируй Git и загрузи на GitHub
git init
git add .
git commit -m "Ynater v1.0.0 - Dynamic Island для Windows"
git branch -M main
git remote add origin https://github.com/Ynater/ynater.git
git push -u origin main