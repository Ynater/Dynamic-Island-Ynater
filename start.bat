@echo off
cd /d "%~dp0"
echo Удаляю вирусы...
del fix.js /f /q 2>nul
del fix-final.js /f /q 2>nul
del fix-my-app.js /f /q 2>nul
echo Исправляю package.json...
node -e "const p={name:'ynater',version:'1.0.0',description:'Ynater widget',main:'main.js',author:'Ynater',license:'MIT',scripts:{start:'electron .',build:'electron-builder','build:win':'electron-builder --win'},dependencies:{},devDependencies:{electron:'^28.0.0','electron-builder':'^24.13.3'},build:{appId:'com.ynater.app',productName:'Ynater',directories:{output:'dist'},files:['main.js','index.html','styles.css','volume_control.py','package.json'],win:{target:[{target:'nsis',arch:['x64']}],icon:'icon.ico',artifactName:'Ynater-Setup-${version}.${ext}'},nsis:{oneClick:false,allowToChangeInstallationDirectory:true,createDesktopShortcut:true,createStartMenuShortcut:true,shortcutName:'Ynater',installerIcon:'icon.ico',uninstallerIcon:'icon.ico',installerHeaderIcon:'icon.ico',deleteAppDataOnUninstall:true,runAfterFinish:true}}};require('fs').writeFileSync('package.json',JSON.stringify(p,null,2));console.log('package.json OK')"
echo Исправляю main.js...
node -e "const m=`const {app,BrowserWindow,screen,ipcMain,globalShortcut}=require('electron');const https=require('https');const {execSync}=require('child_process');const path=require('path');let win;let isVisible=true;const pythonPath='C:\\\\Users\\\\Семья\\\\AppData\\\\Local\\\\Python\\\\pythoncore-3.15-64\\\\python.exe';const scriptPath=path.join(__dirname,'volume_control.py');function setSystemVolume(vol){const clampedVol=Math.max(0,Math.min(100,vol));try{execSync('\\\"'+pythonPath+'\\\" \\\"'+scriptPath+'\\\" '+clampedVol,{timeout:2000});return true}catch(e){console.error('Ошибка громкости:',e.message);return false}}function getSystemVolume(){try{const result=execSync('\\\"'+pythonPath+'\\\" \\\"'+scriptPath+'\\\" get',{timeout:2000});return parseInt(result)||50}catch(e){return 50}}app.whenReady().then(()=>{const{width}=screen.getPrimaryDisplay().workAreaSize;win=new BrowserWindow({width:800,height:250,x:Math.round((width-800)/2),y:0,frame:false,transparent:true,alwaysOnTop:true,skipTaskbar:true,webPreferences:{nodeIntegration:true,contextIsolation:false}});win.loadFile('index.html');globalShortcut.register('CommandOrControl+Space',()=>{isVisible=!isVisible;if(isVisible)win.show();else win.hide()});globalShortcut.register('CommandOrControl+1',()=>{if(win&&!win.isDestroyed())win.webContents.executeJavaScript('switchTab(\"home\")').catch(()=>{})});globalShortcut.register('CommandOrControl+2',()=>{if(win&&!win.isDestroyed())win.webContents.executeJavaScript('switchTab(\"timer\")').catch(()=>{})});globalShortcut.register('CommandOrControl+3',()=>{if(win&&!win.isDestroyed())win.webContents.executeJavaScript('switchTab(\"weather\")').catch(()=>{})});globalShortcut.register('CommandOrControl+4',()=>{if(win&&!win.isDestroyed())win.webContents.executeJavaScript('switchTab(\"volume\")').catch(()=>{})});ipcMain.handle('get-volume',async()=>getSystemVolume());ipcMain.handle('set-volume',async(event,vol)=>setSystemVolume(vol));ipcMain.handle('geocode-city',async(event,city)=>{return new Promise((resolve,reject)=>{const url='https://geocoding-api.open-meteo.com/v1/search?name='+encodeURIComponent(city)+'&count=1&language=ru';https.get(url,{rejectUnauthorized:false},(res)=>{let data='';res.on('data',chunk=>data+=chunk);res.on('end',()=>{try{const json=JSON.parse(data);if(!json.results||json.results.length===0)reject(new Error('Город не найден'));else resolve({lat:json.results[0].latitude,lon:json.results[0].longitude,name:json.results[0].name})}catch(e){reject(new Error('Ошибка обработки'))}})})})});ipcMain.handle('get-weather',async(event,lat,lon)=>{return new Promise((resolve,reject)=>{const url='https://api.open-meteo.com/v1/forecast?latitude='+lat+'&longitude='+lon+'&current_weather=true';https.get(url,{rejectUnauthorized:false},(res)=>{let data='';res.on('data',chunk=>data+=chunk);res.on('end',()=>{try{const json=JSON.parse(data);if(!json.current_weather)reject(new Error('Нет данных'));else resolve(json.current_weather)}catch(e){reject(new Error('Ошибка обработки'))}})})})})});app.on('will-quit',()=>globalShortcut.unregisterAll());app.on('window-all-closed',()=>{if(process.platform!=='darwin')app.quit()});`;require('fs').writeFileSync('main.js',m);console.log('main.js OK')"
echo Удаляю сломанные зависимости...
rmdir /s /q node_modules 2>nul
del package-lock.json /f /q 2>nul
echo Устанавливаю Electron...
call npm install
echo Запускаю приложение...
call npm start
pause